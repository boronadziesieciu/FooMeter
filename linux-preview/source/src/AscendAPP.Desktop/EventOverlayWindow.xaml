<Window x:Class="AscendAPP.Desktop.EventOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AscendAPP.Desktop.Controls" Title="FooMeter · Events" Width="300" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" UseLayoutRounding="True" Foreground="{DynamicResource Tone_F3EEF2}">
 <Window.Resources>
  <DataTemplate x:Key="TimerTemplate"><Border Background="{DynamicResource Tone_171319}" CornerRadius="5" Height="24" Margin="0,0,0,2" Padding="6,3" ToolTip="{Binding Tooltip}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
    <ui:Symbol Kind="{Binding Icon}" Width="11" Height="11" Foreground="{DynamicResource Tone_F28DB8}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10.5" FontWeight="Medium" Margin="2,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="2" Text="{Binding Remaining}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Tone_F28DB8}" TextAlignment="Right" VerticalAlignment="Center"/>
   </Grid>
  </Border></DataTemplate>
 </Window.Resources>
 <Border x:Name="Shell" Margin="2" Background="{DynamicResource Tone_0B0A0D}" BorderBrush="{DynamicResource Tone_383039}" BorderThickness="1" CornerRadius="10">
  <StackPanel x:Name="LayoutRoot">
   <Grid Height="30" Margin="8,0,5,0" Background="Transparent" ToolTip="Drag this title bar to move · hold Alt while locked" MouseLeftButtonDown="Drag_Click"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="MoveHandle" Width="28" Height="26" Margin="0,0,4,0" CornerRadius="5" Cursor="SizeAll" ToolTip="Drag to move · hold Alt while locked" AutomationProperties.Name="Move timer overlay"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Tone_1F1921}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tone_33212D}"/></Trigger></Style.Triggers></Style></Border.Style><ui:Symbol Kind="Grip" Width="16" Height="18" Foreground="{DynamicResource Tone_F28DB8}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Border><ui:Symbol Kind="Bell" Width="15" Height="15" Foreground="{DynamicResource Tone_F28DB8}" Margin="0,0,7,0"/><TextBlock Text="Events &amp; bosses" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" ToolTip="Event settings" AutomationProperties.Name="Event settings" Click="Settings_Click"><ui:Symbol Kind="Settings" Width="14" Height="14"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Hide event overlay" AutomationProperties.Name="Hide event overlay" Click="Hide_Click"><ui:Symbol Kind="Close" Width="13" Height="13" Foreground="#BC9097"/></Button></StackPanel>
   </Grid>
   <ScrollViewer x:Name="TimerScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="540">
    <StackPanel Margin="8,0,8,3">
     <TextBlock x:Name="EventHeading" Text="EVENT SCHEDULE" FontSize="9" Foreground="{DynamicResource Tone_958498}" Margin="2,2,0,4"/>
     <ItemsControl ItemsSource="{Binding ScheduledEvents}" ItemTemplate="{StaticResource TimerTemplate}"/>
     <TextBlock x:Name="BossHeading" Text="FIELD BOSSES · VERTERON" FontSize="9" Foreground="{DynamicResource Tone_958498}" Margin="2,5,0,4"/>
     <ItemsControl ItemsSource="{Binding FieldBossTimers}" ItemTemplate="{StaticResource TimerTemplate}"/>
     <TextBlock x:Name="EmptyMessage" Text="No timers selected. Open event settings." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Tone_A59AA7}" FontSize="10" Margin="5,14"/>
     
    </StackPanel>
   </ScrollViewer>
   <Border BorderBrush="{DynamicResource Tone_2D252F}" BorderThickness="0,1,0,0"><Grid Height="24" Margin="8,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding WorldTimerClock}" ToolTip="{Binding WorldTimerInfo}" FontSize="9" Foreground="{DynamicResource Tone_A59AA7}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="LockButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Lock timer position" AutomationProperties.Name="Lock timer position" Click="Lock_Click"><ui:Symbol x:Name="LockIcon" Kind="Unlock" Width="13" Height="13"/></Button></Grid></Border>
  </StackPanel>
 </Border>
</Window>
