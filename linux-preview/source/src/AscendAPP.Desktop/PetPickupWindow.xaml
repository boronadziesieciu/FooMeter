<Window x:Class="AscendAPP.Desktop.PetPickupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AscendAPP.Desktop.Controls" Title="FooMeter · Soul pickup" Width="310" Height="64" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" UseLayoutRounding="True">
 <Border x:Name="Shell" Margin="2" CornerRadius="8" Background="{DynamicResource Tone_0B0A0D}" BorderBrush="{DynamicResource Tone_383039}" BorderThickness="1" ToolTip="Pet soul pickup · hold Alt to drag beside your game loot list" MouseLeftButtonDown="Drag_Click">
  <Grid x:Name="LayoutRoot" Margin="6,5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="20"/></Grid.RowDefinitions>
   <ui:PetPortrait x:Name="Portrait" Width="40" Height="40" Grid.RowSpan="2" HorizontalAlignment="Left"/>
   <TextBlock x:Name="PetName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="Count" Grid.Column="2" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent}" TextAlignment="Right" VerticalAlignment="Center"/>
   <TextBlock x:Name="Detail" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </Grid>
 </Border>
</Window>
