<Window x:Class="AscendAPP.Desktop.FightHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FooMeter · Encounter history" Width="760" Height="540" MinWidth="650" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource Tone_0B0A0D}" Foreground="{DynamicResource Tone_F3EEF2}" UseLayoutRounding="True">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="HistoryTitle" Text="Encounter history" FontSize="17" Foreground="{DynamicResource Tone_F28DB8}" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="SearchBox" AutomationProperties.Name="Search encounters" ToolTip="Search by target, class or visible player name" TextChanged="Search_Changed"/></Grid>
  <TextBlock x:Name="ResultCount" Grid.Row="2" FontSize="10" Foreground="{DynamicResource Tone_A59AA7}" Margin="0,0,0,8"/>
  <Grid Grid.Row="3"><ListBox x:Name="Fights" Background="{DynamicResource Tone_171219}" Foreground="{DynamicResource Tone_F3EEF2}" DisplayMemberPath="Description" BorderThickness="1" BorderBrush="{DynamicResource Tone_383039}" SelectionChanged="Selection_Changed" MouseDoubleClick="Open_Click"/><TextBlock x:Name="EmptyMessage" Text="No matching encounters" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Tone_A59AA7}"/></Grid>
  <Grid Grid.Row="4" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Compare with" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Column="1" x:Name="Baseline" DisplayMemberPath="Description" AutomationProperties.Name="Comparison baseline" SelectionChanged="Baseline_Changed"/></Grid>
  <TextBlock Grid.Row="5" x:Name="ComparisonSummary" FontSize="11" Foreground="{DynamicResource Tone_A59AA7}" TextWrapping="Wrap" LineHeight="17" MinHeight="56" Margin="0,10,0,0"/>
  <Grid Grid.Row="6" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HistoryStorage" Foreground="{DynamicResource Tone_958498}" FontSize="9" TextWrapping="Wrap" MaxWidth="210" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ExportButton" Content="Export selected" FontSize="10" Padding="8,6" Margin="0,0,5,0" Click="Export_Click"/><Button x:Name="DeleteButton" Content="Delete selected" FontSize="10" Padding="8,6" Margin="0,0,5,0" Click="Delete_Click"/><Button x:Name="ClearHistoryButton" Content="Clear saved" FontSize="10" Padding="8,6" Margin="0,0,5,0" Click="Clear_Click"/><Button x:Name="OpenButton" Content="Open breakdown" FontSize="10" Padding="8,6" Click="Open_Click"/></StackPanel></Grid>
 </Grid>
</Window>
