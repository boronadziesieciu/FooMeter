<Window x:Class="AscendAPP.Desktop.PetOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AscendAPP.Desktop.Controls" Title="FooMeter · Pet souls" Width="350" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False" UseLayoutRounding="True" Foreground="{DynamicResource Tone_F3EEF2}">
 <Border Margin="2" Background="{DynamicResource Tone_0B0A0D}" BorderBrush="{DynamicResource Tone_383039}" BorderThickness="1" CornerRadius="10">
  <StackPanel x:Name="LayoutRoot">
   <Grid Height="36" Margin="10,0,6,0" Background="Transparent" MouseLeftButtonDown="Drag_Click">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="MoveHandle" Width="26" Height="25" Background="{DynamicResource Tone_211821}" CornerRadius="5" Cursor="SizeAll" ToolTip="Drag to move · hold Alt while locked"><ui:Symbol Kind="Pet" Foreground="{DynamicResource Tone_F28DB8}" Width="15" Height="15" IsHitTestVisible="False"/></Border><TextBlock Text="Pet souls" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock x:Name="LiveLabel" Text="WAITING" FontSize="8" Foreground="{DynamicResource Tone_A59AA7}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" ToolTip="Copy pet tracking diagnostics" Click="Diagnostics_Click"><ui:Symbol Kind="Debug" Width="13" Height="13"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Pet settings" Click="Settings_Click"><ui:Symbol Kind="Settings" Width="13" Height="13"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Hide pet tracker" Click="Hide_Click"><ui:Symbol Kind="Close" Width="12" Height="12"/></Button></StackPanel>
   </Grid>
   <Border x:Name="Pickup" Background="{DynamicResource Tone_291B25}" CornerRadius="6" Padding="9,7" Margin="10,1,10,8" Visibility="Collapsed"><TextBlock x:Name="PickupText" Foreground="{DynamicResource Tone_F6AAC9}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/></Border>
   <Grid Margin="10,0,10,7"><TextBox x:Name="Search" MinHeight="26" Padding="8,4" FontSize="10" ToolTip="Search pets by name or ID" AutomationProperties.Name="Search pets" TextChanged="Search_Changed"/><TextBlock Text="Search pets…" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Tone_796C7A}" FontSize="10" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <StackPanel Orientation="Horizontal" Margin="11,0,10,8"><CheckBox x:Name="PinnedOnly" Content="Pinned only" FontSize="9" Checked="Filter_Changed" Unchecked="Filter_Changed"/><CheckBox x:Name="HideCompleted" Content="Hide maxed" FontSize="9" Margin="12,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/></StackPanel>
   <Button Content="Use counters only · hide this window" Margin="10,0,10,7" Padding="8,4" FontSize="10" Click="CounterOnly_Click"/>
   <ScrollViewer x:Name="PetScroller" MaxHeight="235" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl x:Name="PetList" Margin="10,0,10,0"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource Tone_171319}" CornerRadius="5" Margin="0,0,0,4" Padding="8,6" ToolTip="{Binding Detail}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="16"/><RowDefinition Height="2"/></Grid.RowDefinitions>
       <ui:PetPortrait PetId="{Binding Id}" Width="34" Height="34" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
       <TextBlock Grid.Column="2" Text="{Binding Progress}" FontSize="14" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource Tone_F28DB8}"/>
       <Button Grid.Column="3" Grid.RowSpan="2" Width="24" Height="25" Style="{StaticResource IconButton}" ToolTip="{Binding PinHint}" Click="Pin_Click"><ui:Symbol Kind="Pin" Width="12" Height="12" Foreground="{Binding PinColor}"/></Button>
       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Caption}" FontSize="9" Foreground="{DynamicResource Tone_A59AA7}" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2"/>
       <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1,0,0" ClipToBounds="True"><Border Background="{DynamicResource Tone_302530}"/><Border Background="{DynamicResource Tone_E77EAB}" RenderTransformOrigin="0,.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform></Border></Grid>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
   <TextBlock x:Name="Empty" Text="No pets match these filters." HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Tone_A59AA7}" Margin="10,12" Visibility="Collapsed"/>
   <Border BorderBrush="{DynamicResource Tone_302830}" BorderThickness="0,1,0,0" Margin="0,5,0,0"><Grid Margin="11,7,6,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="9" Foreground="{DynamicResource Tone_A59AA7}" LineHeight="13"/><Button x:Name="LockButton" Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Lock pet overlay · hold Alt to interact" Click="Lock_Click"><ui:Symbol x:Name="LockIcon" Kind="Unlock" Width="12" Height="12"/></Button></Grid></Border>
  </StackPanel>
 </Border>
</Window>
