<Window x:Class="AscendAPP.Desktop.SkillBreakdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FooMeter | Skill Analysis" Width="760" Height="620" MinWidth="610" MinHeight="410"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Tone_0B0A0D}" Foreground="{DynamicResource Tone_F3EEF2}">
    <Grid Margin="19">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,15">
            <TextBlock Text="FOOMETER · SKILL ANALYSIS" Foreground="{DynamicResource Tone_F28DB8}" FontSize="12" FontWeight="Bold"/>
            <TextBlock x:Name="EncounterText" FontSize="22" Margin="0,4,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="PLAYER" Foreground="{DynamicResource Tone_A59AA7}" Margin="0,8,12,0"/>
            <ComboBox x:Name="PlayerSelector" Width="200" Height="31" DisplayMemberPath="Name"
                      SelectionChanged="PlayerSelector_SelectionChanged" HorizontalAlignment="Left"/>
        </DockPanel>
        <Border Grid.Row="2" Background="{DynamicResource Tone_171219}" BorderBrush="{DynamicResource Tone_383039}" BorderThickness="1" CornerRadius="11" Padding="15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="Summary" FontSize="13" Foreground="{DynamicResource Tone_F3EEF2}" Margin="0,0,0,16"/>
                <Grid Grid.Row="1" Margin="5,0,5,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="92"/><ColumnDefinition Width="75"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBlock Text="SKILL" Foreground="{DynamicResource Tone_A59AA7}"/><TextBlock Grid.Column="1" Text="HITS" TextAlignment="Right" Foreground="{DynamicResource Tone_A59AA7}"/>
                    <TextBlock x:Name="AmountHeading" Grid.Column="2" Text="DAMAGE" TextAlignment="Right" Foreground="{DynamicResource Tone_A59AA7}"/>
                    <TextBlock Grid.Column="3" Text="CRIT" TextAlignment="Right" Foreground="{DynamicResource Tone_A59AA7}"/>
                    <TextBlock Grid.Column="4" Text="MAX" TextAlignment="Right" Foreground="{DynamicResource Tone_A59AA7}"/>
                </Grid>
                <DataGrid Grid.Row="2" ItemsSource="{Binding}" IsReadOnly="True" AutoGenerateColumns="False"
                          Background="{DynamicResource Tone_171219}" Foreground="{DynamicResource Tone_F3EEF2}" RowBackground="#222C36" AlternatingRowBackground="#1D262F"
                          HeadersVisibility="None" GridLinesVisibility="None" CanUserAddRows="False" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="60"/>
                        <DataGridTextColumn Header="Damage" Binding="{Binding Damage}" Width="92"/>
                        <DataGridTextColumn Header="Crit" Binding="{Binding Crit}" Width="75"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
