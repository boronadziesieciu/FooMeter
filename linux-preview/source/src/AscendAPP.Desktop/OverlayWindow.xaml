<Window x:Class="AscendAPP.Desktop.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:AscendAPP.Desktop.Controls" Title="FooMeter · Compact" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="True" UseLayoutRounding="True" Foreground="{DynamicResource Tone_F3EEF2}">
 <Window.Resources>
  <Style x:Key="Micro" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Tone_A59AA7}"/></Style>
  <Style x:Key="Tab" TargetType="Button"><Setter Property="Padding" Value="8,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Tone_A59AA7}"/><Setter Property="FontSize" Value="10"/></Style>
  <Style x:Key="DamageTab" TargetType="Button" BasedOn="{StaticResource Tab}"><Style.Triggers><DataTrigger Binding="{Binding ShowHealing}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Tone_F28DB8}"/><Setter Property="Background" Value="{DynamicResource Tone_33212D}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="HealTab" TargetType="Button" BasedOn="{StaticResource Tab}"><Style.Triggers><DataTrigger Binding="{Binding ShowHealing}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tone_F28DB8}"/><Setter Property="Background" Value="{DynamicResource Tone_33212D}"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="PlayerTemplate"><Border x:Name="row" Height="26" Margin="0,0,0,3" CornerRadius="4" Background="{DynamicResource Tone_171319}" MouseLeftButtonUp="Player_Click" Cursor="Hand" ToolTip="{Binding Info}">
   <Grid ClipToBounds="True"><Border Background="{Binding Bar}" Opacity="0.17" CornerRadius="4" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding OverlayFill}"/></Border.RenderTransform></Border>
    <Grid x:Name="PlayerLine" Margin="6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition x:Name="TotalCol" Width="48"/></Grid.ColumnDefinitions>
     <ui:ClassBadge ClassName="{Binding ClassName}" Foreground="{Binding Bar}" Width="20" Height="20" VerticalAlignment="Center" ToolTip="{Binding ClassName}"/>
     <TextBlock x:Name="PlayerName" Grid.Column="1" MaxWidth="90" Text="{Binding DisplayName}" FontSize="11" Margin="2,0,7,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="PlayerGearScore" Grid.Column="2" Margin="3,0,0,0" FontSize="9.5" Foreground="{DynamicResource Tone_B3A4B7}" VerticalAlignment="Center" ToolTip="{Binding RatingInfo}"><Run Text="GS "/><Run Text="{Binding GearScore}"/></TextBlock>
     <TextBlock x:Name="PlayerCombatPower" Grid.Column="3" Margin="8,0,0,0" FontSize="9.5" Foreground="{DynamicResource Tone_B3A4B7}" VerticalAlignment="Center" ToolTip="{Binding RatingInfo}"><Run Text="CP "/><Run Text="{Binding CombatPower}"/></TextBlock>
     <ui:SmoothText x:Name="PlayerRate" Grid.Column="5" TransitionsEnabled="{Binding DataContext.Preferences.SmoothNumbers,RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding DisplayRate}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
     <ui:SmoothText x:Name="total" Grid.Column="6" TransitionsEnabled="{Binding DataContext.Preferences.SmoothNumbers,RelativeSource={RelativeSource AncestorType=Window}}" Text="{Binding DisplayAmount}" FontSize="10" Foreground="{DynamicResource Tone_B8ABB9}" VerticalAlignment="Center" TextAlignment="Right"/>
    </Grid>
   </Grid>
  </Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelf}" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource Tone_B45C8A}"/><Setter TargetName="row" Property="BorderThickness" Value="1,0,0,0"/></DataTrigger><DataTrigger Binding="{Binding DataContext.Preferences.HideTotalDamage,RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="TotalCol" Property="Width" Value="0"/><Setter TargetName="total" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Border x:Name="Shell" Margin="2" Background="{DynamicResource Tone_0B0A0D}" BorderBrush="{DynamicResource Tone_383039}" BorderThickness="1" CornerRadius="10">
  <StackPanel x:Name="LayoutRoot">
   <Grid x:Name="StripPanel" Height="36" Margin="7,0" Visibility="Collapsed" Background="Transparent" MouseLeftButtonDown="Drag_Click">
    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="20"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="62"/><ColumnDefinition Width="37"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
    <Border x:Name="StripMoveHandle" Width="25" Height="26" Background="{DynamicResource Tone_1F1921}" CornerRadius="4" Cursor="SizeAll" ToolTip="Drag to move · hold Alt while locked"><ui:Symbol Kind="Grip" Width="15" Height="17" Foreground="{DynamicResource Tone_F28DB8}" IsHitTestVisible="False"/></Border>
    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="20" ToolTip="{Binding CaptureDetail}" AutomationProperties.Name="Capture diagnostics" Click="CaptureStatus_Click"><Ellipse Width="7" Height="7" Fill="{Binding CaptureColor}"/></Button>
    <TextBlock Grid.Column="2" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding StripSelfTitle}"><Run Text="You "/><Run Text="{Binding StripSelfRate,Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Tone_F28DB8}"/></TextBlock>
    <TextBlock Grid.Column="3" FontSize="10" VerticalAlignment="Center" ToolTip="Full encounter party DPS"><Run Text="Party "/><Run Text="{Binding StripPartyRate,Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
    <TextBlock Grid.Column="4" Text="{Binding EncounterName}" FontSize="10" Foreground="{DynamicResource Tone_A59AA7}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0,6,0" ToolTip="{Binding EncounterName}"/>
    <TextBlock Grid.Column="5" Text="{Binding StripHealth}" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding BossHealthText}"/>
    <TextBlock Grid.Column="6" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding ForecastTooltip}"><Run Text="B "/><Run Text="{Binding BerserkIn}"/></TextBlock>
    <TextBlock Grid.Column="7" Text="{Binding Clock}" FontSize="10" Foreground="{DynamicResource Tone_998C9B}" VerticalAlignment="Center"/>
    <Button Grid.Column="8" Style="{StaticResource IconButton}" Width="26" ToolTip="Settings" Click="Settings_Click"><ui:Symbol Kind="Settings" Width="13" Height="13"/></Button>
    <Button Grid.Column="9" Style="{StaticResource IconButton}" Width="26" ToolTip="Expand combat meter" AutomationProperties.Name="Expand combat meter" Click="Strip_Click"><ui:Symbol Kind="Overlay" Width="13" Height="13"/></Button>
    <Button Grid.Column="10" Style="{StaticResource IconButton}" Width="26" ToolTip="Lock strip · hold Alt to interact" Click="Lock_Click"><ui:Symbol x:Name="StripLockIcon" Kind="Unlock" Width="12" Height="12"/></Button>
    <Button Grid.Column="11" Style="{StaticResource IconButton}" Width="26" ToolTip="More actions" Click="Menu_Click"><ui:Symbol Kind="Menu" Width="13" Height="13"/></Button>
   </Grid>
   <Grid x:Name="Header" Height="36" Margin="9,0,5,0" Background="Transparent" ToolTip="FooMeter · drag to move · hold Alt while locked" MouseLeftButtonDown="Drag_Click">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="MoveHandle" Width="28" Height="26" Margin="0,0,4,0" CornerRadius="5" Cursor="SizeAll" ToolTip="Drag to move · hold Alt while locked" AutomationProperties.Name="Move damage overlay"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Tone_1F1921}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tone_33212D}"/></Trigger></Style.Triggers></Style></Border.Style><ui:Symbol Kind="Grip" Width="16" Height="18" Foreground="{DynamicResource Tone_F28DB8}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Border><ui:Symbol Kind="Brand" Foreground="{DynamicResource Tone_F28DB8}" Width="15" Height="16" Margin="0,0,7,0"/><Button x:Name="CaptureIndicator" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="{Binding CaptureDetail}" AutomationProperties.Name="Capture status and diagnostics" Click="CaptureStatus_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding CaptureColor}" Margin="0,0,5,0"/><TextBlock Text="{Binding CaptureLabel}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="{Binding Clock}" FontSize="10" Foreground="{DynamicResource Tone_998C9B}" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource IconButton}" ToolTip="Toggle one-line combat strip" AutomationProperties.Name="Toggle one-line combat strip" Click="Strip_Click"><ui:Symbol Kind="Strip" Width="14" Height="14"/></Button>
     <Button Style="{StaticResource IconButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click"><ui:Symbol Kind="Settings" Width="14" Height="14"/></Button>
     <Button Style="{StaticResource IconButton}" x:Name="EventsButton" ToolTip="Toggle events and boss timers" AutomationProperties.Name="Toggle events and boss timers" Click="Events_Click"><ui:Symbol Kind="Bell" Width="14" Height="14"/></Button>
     <Button Style="{StaticResource IconButton}" x:Name="PetsButton" ToolTip="Toggle pet-soul tracker" AutomationProperties.Name="Toggle pet-soul tracker" Click="Pets_Click"><ui:Symbol Kind="Pet" Width="14" Height="14"/></Button>
     <Button Style="{StaticResource IconButton}" ToolTip="Capture, timers and exports" AutomationProperties.Name="More actions" Click="Menu_Click"><ui:Symbol Kind="Menu" Width="14" Height="14"/></Button>
     <Button Style="{StaticResource IconButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click"><ui:Symbol Kind="Minus" Width="13" Height="13"/></Button>
     <Button Style="{StaticResource IconButton}" ToolTip="Exit FooMeter" AutomationProperties.Name="Exit" Click="Close_Click"><ui:Symbol Kind="Close" Width="13" Height="13" Foreground="#BC9097"/></Button>
    </StackPanel>
   </Grid>
   <Grid x:Name="IdlePanel" Height="56" Margin="15,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="IdleTitle" Text="Searching for game traffic…" FontSize="11" Foreground="{DynamicResource Tone_A59AA7}" HorizontalAlignment="Center"/><TextBlock x:Name="IdleHint" Text="Start before character entry" FontSize="9" Foreground="{DynamicResource Tone_918394}" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
   <StackPanel x:Name="CombatPanel" Margin="11,2,11,0">
    <Grid x:Name="TargetHeader" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EncounterName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding BossHealthText}" Style="{StaticResource Micro}" MaxWidth="190" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/></Grid>
    <Grid x:Name="HpBar" Height="3" Margin="0,0,0,6" ClipToBounds="True"><Border Background="{DynamicResource Tone_383039}" CornerRadius="2"/><Border Background="{DynamicResource Tone_F28DB8}" CornerRadius="2" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform ScaleX="{Binding BossHealthFraction}"/></Border.RenderTransform></Border></Grid>
    <Grid x:Name="ForecastPanel" Margin="0,0,0,7" ToolTip="{Binding ForecastTooltip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontSize="10" Foreground="{DynamicResource Tone_B8ABB9}"><Run Text="Defeat "/><Run Text="{Binding TimeToKill}"/><Run Text="   ·   Berserk "/><Run Text="{Binding BerserkIn}"/></TextBlock><TextBlock Grid.Column="1" Text="{Binding ForecastMargin}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Tone_F28DB8}"/><Style.Triggers><DataTrigger Binding="{Binding ForecastWarning}" Value="True"><Setter Property="Foreground" Value="#E8B586"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
    <Grid Height="29" Margin="-4,0,-4,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Style="{StaticResource DamageTab}" Click="Damage_Click" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><ui:Symbol Kind="Combat" Width="11" Height="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0"/><TextBlock Text="Damage"/></StackPanel></Button><Button Style="{StaticResource HealTab}" Click="Healing_Click"><StackPanel Orientation="Horizontal"><ui:Symbol Kind="Heal" Width="11" Height="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,5,0"/><TextBlock Text="Healing"/></StackPanel></Button></StackPanel><TextBlock Grid.Column="1" Text="{Binding RateTitle}" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,9,0"/></Grid>
    <ScrollViewer x:Name="PlayerScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="174"><ItemsControl ItemsSource="{Binding OverlayRows}" ItemTemplate="{StaticResource PlayerTemplate}"/></ScrollViewer>
    <TextBlock x:Name="HealingInfo" Text="{Binding HealingInfo}" Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis" Margin="2,3,2,4" ToolTip="Live eHPS is a conservative HP-based estimate. Full-health heals are excluded. Missing/stale HP, intervening damage and overlapping heals remain unscored; see diagnostics. Older replays retain their original totals."/>
    <Grid x:Name="PartyPanel" Margin="2,4,2,7" ToolTip="{Binding ForecastScope}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ForecastScope}" Style="{StaticResource Micro}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding ForecastRate}" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"/></Grid>
   </StackPanel>
   <ScrollViewer x:Name="TimerHost" MaxHeight="92" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="TimerPanel" ItemsSource="{Binding Timers}" Margin="11,0,11,3"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="23"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:Symbol Kind="{Binding Icon}" Width="12" Height="12"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource Tone_B4A8BD}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Remaining}" FontSize="10" Foreground="{DynamicResource Tone_F28DB8}" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <Border x:Name="NoticePanel" Background="{DynamicResource Tone_302031}" CornerRadius="5" Margin="10,2,10,5" Padding="7,5"><TextBlock Text="{Binding Notice}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource Tone_F6AAC9}"/></Border>
   <Border x:Name="Footer" BorderBrush="{DynamicResource Tone_2D252F}" BorderThickness="0,1,0,0"><Grid Height="30" Margin="10,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid VerticalAlignment="Center" Margin="0,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:ClassBadge ClassName="{Binding SelfClass}" Width="18" Height="18" Foreground="{DynamicResource Tone_F28DB8}" ToolTip="{Binding SelfClass}"/><TextBlock Grid.Column="1" Text="{Binding SelfName}" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,5,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><Button x:Name="OwnRatings" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" ToolTip="{Binding SelfRatingInfo}" AutomationProperties.Name="Your GS and CP" Click="Ratings_Click"><StackPanel Orientation="Horizontal"><TextBlock FontSize="9.5" Foreground="{DynamicResource Tone_B3A4B7}"><Run Text="GS "/><Run Text="{Binding SelfGearScore}"/></TextBlock><TextBlock FontSize="9.5" Foreground="{DynamicResource Tone_B3A4B7}" Margin="7,0,0,0"><Run Text="CP "/><Run Text="{Binding SelfCombatPower}"/></TextBlock></StackPanel></Button></Grid><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Width="Auto" ToolTip="Character tickets and energy" Click="Tickets_Click"><StackPanel Orientation="Horizontal"><ui:Symbol Kind="Ticket" Width="13" Height="13" Margin="0,0,5,0"/><TextBlock FontSize="10" Foreground="{DynamicResource Tone_B4A8BD}"><Run Text="Odyle "/><Run Text="{Binding OdyleAvailable}"/></TextBlock></StackPanel></Button><Button x:Name="LockButton" Style="{StaticResource IconButton}" ToolTip="Lock position" Click="Lock_Click"><ui:Symbol x:Name="LockIcon" Kind="Unlock" Width="13" Height="13"/></Button></StackPanel></Grid></Border>
  </StackPanel>
 </Border>
</Window>
